{
  "name": "Vemtap",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start:env": "ENVFILE=.env.development expo start",
    "ios:env": "ENVFILE=.env.development expo run:ios",
    "android:env": "ENVFILE=.env.development expo run:android",
    "doctor": "expo-doctor",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native-firebase/remote-config": "^26.4.0",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@sentry/react-native": "^8.27.0",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/query-async-storage-persister": "^5.103.2",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-persist-client": "^5.103.2",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "expo": "~58.0.0",
    "jail-monkey": "^3.0.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-native": "0.87.1",
    "react-native-bootsplash": "^7.3.3",
    "react-native-config": "^1.7.2",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.7.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.28.0",
    "react-native-worklets": "^0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@sentry/cli": "^3.8.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^8.19.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "expo": "^58.0.0-preview.4",
    "expo-dev-client": "^58.0.4",
    "expo-doctor": "^1.20.4",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "react-native-bootsplash",
        "@shopify/flash-list",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-worklets",
        "react",
        "react-native"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-image"
        ]
      }
    }
  }
}
