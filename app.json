{
  "name": "Vemtap",
  "slug": "vemtap",
  "version": "0.0.1",
  "icon": "./src/assets/images/vemtap-logo-icon.png",
  "orientation": "portrait",
  "userInterfaceStyle": "light",
  "ios": {
    "bundleIdentifier": "com.vemtap.app",
    "infoPlist": {
      "ITSAppUsesNonExemptEncryption": false
    }
  },
  "android": {
    "package": "com.vemtap.app",
    "config": {
      "googleMaps": {
        "apiKey": ""
      }
    }
  },
  "owner": "vemtap",
  "plugins": [
    [
      "expo-splash-screen",
      {
        "image": "./src/assets/images/vemtap-square-logo.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    ],
    "expo-font",
    "expo-notifications"
  ],
  "extra": {
    "eas": {
      "projectId": "77c2bfe7-536a-4c0a-8d2a-639044ab58b0"
    }
  }
}
