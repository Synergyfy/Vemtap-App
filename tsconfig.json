{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "types": ["nativewind/types", "jest"],
    "paths": {
      "@components/*": ["src/components/*"],
      "@screens/*": ["src/features/*"],
      "@hooks/*": ["src/hooks/*"],
      "@utils/*": ["src/utils/*"],
      "@services/*": ["src/services/*"],
      "@store/*": ["src/store/*"],
      "@assets/*": ["src/assets/*"],
      "@app-types/*": ["src/types/*"],
      "@constants/*": ["src/constants/*"],
      "@api/*": ["src/api/*"],
      "@features/*": ["src/features/*"],
      "@navigation/*": ["src/navigation/*"],
      "@theme/*": ["src/theme/*"],
      "@app/*": ["src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": ["**/node_modules", "**/Pods", "**/fastlane"]
}
