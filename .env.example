# Environment template — copy to .env.development / .env.staging / .env.production
# Values are inlined into the JS bundle by Expo CLI when prefixed with EXPO_PUBLIC_
# (loaded from .env.development in dev, .env.production in prod builds).
# NEVER put real secrets here (see EAS secrets for production values).

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=https://api.dev.vemtap.com
EXPO_PUBLIC_API_VERSION=v1
EXPO_PUBLIC_API_TIMEOUT_MS=15000

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENABLED=false

# Minimum supported app version for force-update checks (semver)
EXPO_PUBLIC_MIN_SUPPORTED_APP_VERSION=1.0.0

# Google Maps (Android). Empty → LocationMapView uses the designed fallback
# (Expo Go Android cannot load real tiles — built-in key is blank/expired).
# For real tiles: enable Maps SDK for Android in Google Cloud, restrict to
# android.package + SHA-1, set the value below, then rebuild the native app.
# Injected into android.config.googleMaps.apiKey by app.config.js.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=