# Environment template — copy to .env.development / .env.staging / .env.production
# Values are embedded into the JS bundle by react-native-config. NEVER put real secrets here.

APP_ENV=development
API_BASE_URL=https://api.dev.vemtap.com
API_VERSION=v1
API_TIMEOUT_MS=15000

SENTRY_DSN=
SENTRY_ENABLED=false

FIREBASE_REALTIME_DB_URL=

# Minimum supported app version for force-update checks (semver)
MIN_SUPPORTED_APP_VERSION=1.0.0
